<?xml version="1.0" ?>
<robot name="astra" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Load Simulated or Real Hardware Interfaces -->
    <xacro:arg name="is_sim" default="true"/>

    <xacro:include filename="$(find astra_description)/urdf/astra_base.xacro" />
    <xacro:include filename="$(find astra_description)/urdf/astra_sensors.xacro"/>
    <xacro:include filename="$(find astra_description)/urdf/astra_gazebo.xacro"/>
    <xacro:include filename="$(find astra_description)/urdf/astra_ros2control.xacro"/>

</robot>
